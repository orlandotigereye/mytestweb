    "checks": [
      "input_range",
      "enum_match",
      "map_exists",
      "formula_result",
      "score_range"
    ]
  },
  "computation_rules": {
    "precision": {
      "floating_point_standard": "IEEE_754_double_precision",
      "decimal_places": 2,
      "rounding_mode": "ROUND_HALF_UP",
      "scientific_notation_threshold": 1e-6,
      "max_value": 1e10,
      "min_value": -1e10
    },
    "operations": {
      "addition": {
        "mode": "exact_double_precision",
        "overflow_handling": "clamp_to_max_value"
      },
      "subtraction": {
        "mode": "exact_double_precision",
        "underflow_handling": "clamp_to_min_value"
      },
      "multiplication": {
        "mode": "exact_double_precision",
        "precision_loss_tolerance": 1e-10
      },
      "division": {
        "mode": "exact_double_precision",
        "zero_division_handling": "use_fallback_value_0",
        "near_zero_threshold": 1e-10
      },
      "modulo": {
        "mode": "truncated_division",
        "sign_handling": "dividend_sign"
      },
      "absolute_value": {
        "mode": "standard_mathematical"
      },
      "min_max": {
        "mode": "lexicographic_comparison",
        "tie_breaking": "first_occurrence"
      }
    },
    "clamping": {
      "score_bounds": {
        "enabled": true,
        "min": 0,
        "max": 100
      },
      "formula_results": {
        "enabled": true,
        "clamp_before_next_step": true
      }
    }
  },
  "precision_control": {
    "rounding_mode": "HALF_UP",
    "decimal_places": 4,
    "apply_to": [
      "trend_score",
      "risk_score",
      "final_score"
    ]
  },
