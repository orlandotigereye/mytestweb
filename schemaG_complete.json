  "formulas": {
    "step_1_base_scores": {
      "trend_jupiter": {
        "description": "Distance from anchor 120 degrees",
        "formula": "100 - abs(moon_jupiter - 120) / 120 * 100",
        "step_by_step": [
          "diff = moon_jupiter - 120",
          "abs_diff = abs(diff)",
          "ratio = abs_diff / 120",
          "percentage = ratio * 100",
          "result = 100 - percentage"
        ],
        "example": {
          "input": 120,
          "step_1_diff": 0,
          "step_2_abs": 0,
          "step_3_ratio": 0,
          "step_4_pct": 0,
          "output": 100
        },
        "clamp": true,
        "min": 0,
        "max": 100
      },
      "risk_saturn": {
        "description": "Distance from anchor 180 degrees",
        "formula": "100 - abs(moon_saturn - 180) / 180 * 100",
        "step_by_step": [
          "diff = moon_saturn - 180",
          "abs_diff = abs(diff)",
          "ratio = abs_diff / 180",
          "percentage = ratio * 100",
          "result = 100 - percentage"
        ],
        "clamp": true,
        "min": 0,
        "max": 100
      },
      "volatility_mars": {
        "description": "Distance from anchor 180 degrees",
        "formula": "100 - abs(mars_angle - 180) / 180 * 100",
        "step_by_step": [
          "diff = mars_angle - 180",
          "abs_diff = abs(diff)",
          "ratio = abs_diff / 180",
          "percentage = ratio * 100",
          "result = 100 - percentage"
        ],
        "clamp": true,
        "min": 0,
        "max": 100
      },
      "element_score": {
        "description": "Inverse of element imbalance",
        "formula": "100 - (max(wood,fire,earth,metal,water) - min(wood,fire,earth,metal,water)) * 2",
        "step_by_step": [
          "elements_list = [wood, fire, earth, metal, water]",
          "max_val = max(elements_list)",
          "min_val = min(elements_list)",
          "diff = max_val - min_val",
          "weighted_diff = diff * 2",
          "result = 100 - weighted_diff"
        ],
        "example": {
          "wood": 50,
          "fire": 50,
          "earth": 50,
          "metal": 50,
          "water": 50,
          "max": 50,
          "min": 50,
          "diff": 0,
          "weighted": 0,
          "output": 100
        },
        "clamp": true,
        "min": 0,
        "max": 100
      },
      "solar_term_score": {
        "description": "Days since solar term (0 days = 100, 15 days = 0)",
        "formula": "max(0, 100 - (solar_term_days / 15 * 100))",
        "step_by_step": [
          "ratio = solar_term_days / 15",
          "percentage = ratio * 100",
          "result_raw = 100 - percentage",
          "result = max(0, result_raw)"
        ],
        "example": {
          "solar_term_days": 0,
          "ratio": 0,
          "percentage": 0,
          "raw": 100,
          "output": 100
        },
        "clamp": true,
        "min": 0,
        "max": 100
      },
      "moon_phase_value": {
        "description": "Map moon phase to score",
        "operation": "lookup maps.moon_phase[input.moon_phase]",
        "example": {
          "input": "full_moon",
          "output": 85
        }
      },
      "host_star_value": {
        "description": "Map host star to score",
        "operation": "lookup maps.host_star_score[input.host_star]",
        "fallback": "maps.fallback_values.host_star_unknown = 75",
        "example": {
          "input": "昴日雞",
          "output": 85
        }
      },
      "ganzhi_value": {
        "description": "Map ganzhi to score",
        "operation": "lookup maps.ganzhi_score[input.ganzhi]",
        "example": {
          "input": "甲子",
          "output": 50
        }
      }
    },
    "step_2_composite_scores": {
      "trend_score": {
        "description": "Composite trend indicator",
        "formula": "0.40 * trend_jupiter + 0.20 * moon_phase_value + 0.15 * host_star_value + 0.15 * element_score + 0.10 * solar_term_score",
        "weights": {
          "trend_jupiter": 0.40,
          "moon_phase_value": 0.20,
          "host_star_value": 0.15,
          "element_score": 0.15,
          "solar_term_score": 0.10
        },
        "weight_sum": 1.0,
        "step_by_step": [
          "w1 = 0.40 * trend_jupiter",
          "w2 = 0.20 * moon_phase_value",
          "w3 = 0.15 * host_star_value",
          "w4 = 0.15 * element_score",
          "w5 = 0.10 * solar_term_score",
          "result = w1 + w2 + w3 + w4 + w5"
        ],
        "clamp": true,
        "min": 0,
        "max": 100
      },
      "risk_score": {
        "description": "Composite risk indicator",
        "formula": "0.60 * risk_saturn + 0.40 * volatility_mars",
        "weights": {
          "risk_saturn": 0.60,
          "volatility_mars": 0.40
        },
        "weight_sum": 1.0,
        "step_by_step": [
          "w1 = 0.60 * risk_saturn",
          "w2 = 0.40 * volatility_mars",
          "result = w1 + w2"
        ],
        "clamp": true,
        "min": 0,
        "max": 100
      }
    },
    "step_3_final_score": {
      "final_score": {
        "description": "Trend adjusted by risk",
        "formula": "trend_score - (risk_score * 0.3)",
        "step_by_step": [
          "risk_adjustment = risk_score * 0.3",
          "result_raw = trend_score - risk_adjustment",
          "result = clamp(result_raw, 0, 100)"
        ],
        "clamp": true,
        "min": 0,
        "max": 100
      }
    }
  },
  "engine": {
    "constants": {
      "trend_anchor": 120,
      "risk_anchor": 180,
      "vol_anchor": 180,
      "cycle_length": 4,
      "ganzhi_cycle_length": 60,
      "lunar_mansion_count": 28
    },
    "weights": {
      "trend": {
        "jupiter": 0.40,
        "moon_phase": 0.20,
        "host_star": 0.15,
        "elements": 0.15,
        "solar_term": 0.10,
        "total": 1.0
      },
      "risk": {
        "saturn": 0.60,
        "mars": 0.40,
        "total": 1.0
      }
    },
    "determinism_hash": {
      "enabled": true,
      "method": "sha256",
      "input_for_hash": "sorted_json(input) + epoch_date + deterministic_rules",
      "purpose": "cross_ai_verification"
    },
    "execution_lock": {
      "enforce_strict_mapping": true,
      "bindings": {
        "moon_phase": "maps.moon_phase[input.moon_phase]",
        "host_star": "maps.host_star_score[input.host_star]",
        "ganzhi": "maps.ganzhi_score[input.ganzhi]"
      },
      "no_raw_string_usage": true,
      "no_ai_interpretation": true,
      "no_inference": true,
      "force_numeric_cast": true,
      "fail_on_unmapped": true
    },
    "drift_model": {
      "description": "How values change over time",
      "trend_jupiter_step": 0.2,
      "saturn_step": 0.15,
      "mars_step": 0.3,
      "mode": "linear_deterministic",
      "steps": [
        {
          "day": 0,
          "moon_jupiter_change": 0,
          "moon_saturn_change": 0,
          "mars_angle_change": 0
        },
        {
          "day": 1,
          "moon_jupiter_change": 0.25,
          "moon_saturn_change": 0.18,
          "mars_angle_change": 0.35
        }
      ]
    },
    "epoch": {
      "base_date": "2026-05-30",
      "base_date_format": "YYYY-MM-DD",
      "unit": "days",
      "reference_system": "gregorian_calendar",
      "timezone": "UTC"
    },
    "scan_rule": {
      "condition": "cycle.state == 'D1' AND trend_score >= 85 AND risk_score >= 80 AND volatility_mars >= 85",
      "description": "D1 trigger condition",
      "thresholds": {
        "trend_score_min": 85,
        "risk_score_min": 80,
        "volatility_mars_min": 85,
        "cycle_state_required": "D1"
      },
      "stop_at_first_hit": true,
      "evaluation_order": [
        "cycle_state_check",
        "trend_score_check",
        "risk_score_check",
        "volatility_mars_check"
      ]
    },
    "time_propagation": {
      "enabled": true,
      "mode": "linear_accumulation",
      "rules": {
        "moon_jupiter": {
          "change_per_day": 0.25,
          "unit": "degrees",
          "description": "Jupiter moves 0.25° per day"
        },
        "moon_saturn": {
          "change_per_day": 0.18,
          "unit": "degrees",
          "description": "Saturn moves 0.18° per day"
        },
        "mars_angle": {
          "change_per_day": 0.35,
          "unit": "degrees",
          "description": "Mars moves 0.35° per day"
        }
