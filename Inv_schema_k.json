			{
				"step": 1,
				"name": "validate_input",
				"action": "Check all inputs against schema and ranges",
				"failure_mode": "reject_and_error"
			},
			{
				"step": 2,
				"name": "map_values",
				"action": "Convert strings to numeric scores via maps",
				"lookups": [
					"moon_phase → moon_phase_value",
					"host_star → host_star_value",
					"ganzhi → ganzhi_value"
