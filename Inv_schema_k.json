					"step_1_diff": 0,
					"step_2_abs": 0,
					"step_3_ratio": 0,
					"step_4_pct": 0,
					"output": 100
				},
				"clamp": true,
				"min": 0,
				"max": 100
			},
			"risk_saturn": {
				"description": "Distance from anchor 180 degrees",
				"formula": "100 - abs(moon_saturn - 180) / 180 * 100",
				"step_by_step": [
					"diff = moon_saturn - 180",
					"abs_diff = abs(diff)",
					"ratio = abs_diff / 180",
					"percentage = ratio * 100",
					"result = 100 - percentage"
				],
				"clamp": true,
				"min": 0,
				"max": 100
			},
			"volatility_mars": {
				"description": "Distance from anchor 180 degrees",
				"formula": "100 - abs(mars_angle - 180) / 180 * 100",
				"step_by_step": [
					"diff = mars_angle - 180",
					"abs_diff = abs(diff)",
					"ratio = abs_diff / 180",
					"percentage = ratio * 100",
					"result = 100 - percentage"
				],
				"clamp": true,
				"min": 0,
				"max": 100
			},
			"element_score": {
				"description": "Inverse of element imbalance",
				"formula": "100 - (max(wood,fire,earth,metal,water) - min(wood,fire,earth,metal,water)) * 2",
				"step_by_step": [
					"elements_list = [wood, fire, earth, metal, water]",
					"max_val = max(elements_list)",
					"min_val = min(elements_list)",
					"diff = max_val - min_val",
					"weighted_diff = diff * 2",
					"result = 100 - weighted_diff"
				],
				"example": {
					"wood": 50,
					"fire": 50,
					"earth": 50,
					"metal": 50,
					"water": 50,
					"max": 50,
					"min": 50,
					"diff": 0,
					"weighted": 0,
					"output": 100
				},
				"clamp": true,
				"min": 0,
				"max": 100
			},
			"solar_term_score": {
				"description": "Days since solar term (0 days = 100, 15 days = 0)",
				"formula": "max(0, 100 - (solar_term_days / 15 * 100))",
				"step_by_step": [
					"ratio = solar_term_days / 15",
					"percentage = ratio * 100",
					"result_raw = 100 - percentage",
					"result = max(0, result_raw)"
				],
				"example": {
					"solar_term_days": 0,
					"ratio": 0,
					"percentage": 0,
					"raw": 100,
					"output": 100
				},
				"clamp": true,
				"min": 0,
				"max": 100
			},
			"moon_phase_value": {
				"description": "Map moon phase to score",
				"operation": "lookup maps.moon_phase[input.moon_phase]",
				"example": {
					"input": "full_moon",
					"output": 85
				}
			},
			"host_star_value": {
				"description": "Map host star to score",
				"operation": "lookup maps.host_star_score[input.host_star]",
				"fallback": "maps.fallback_values.host_star_unknown = 75",
				"example": {
					"input": "昴日雞",
					"output": 85
				}
			},
			"ganzhi_value": {
				"description": "Map ganzhi to score",
				"operation": "lookup maps.ganzhi_score[input.ganzhi]",
				"example": {
					"input": "甲子",
					"output": 50
				}
			}
		},
		"step_2_composite_scores": {
			"trend_score": {
				"description": "Composite trend indicator",
				"formula": "0.40 * trend_jupiter + 0.20 * moon_phase_value + 0.15 * host_star_value + 0.15 * element_score + 0.10 * solar_term_score",
				"weights": {
					"trend_jupiter": 0.4,
					"moon_phase_value": 0.2,
					"host_star_value": 0.15,
					"element_score": 0.15,
					"solar_term_score": 0.1
				},
				"weight_sum": 1,
				"step_by_step": [
					"w1 = 0.40 * trend_jupiter",
					"w2 = 0.20 * moon_phase_value",
					"w3 = 0.15 * host_star_value",
					"w4 = 0.15 * element_score",
					"w5 = 0.10 * solar_term_score",
					"result = w1 + w2 + w3 + w4 + w5"
				],
				"clamp": true,
				"min": 0,
				"max": 100
			},
			"risk_score": {
				"description": "Composite risk indicator",
				"formula": "0.60 * risk_saturn + 0.40 * volatility_mars",
				"weights": {
					"risk_saturn": 0.6,
					"volatility_mars": 0.4
				},
				"weight_sum": 1,
				"step_by_step": [
					"w1 = 0.60 * risk_saturn",
					"w2 = 0.40 * volatility_mars",
					"result = w1 + w2"
				],
				"clamp": true,
				"min": 0,
				"max": 100
			}
		},
		"step_3_final_score": {
			"final_score": {
				"description": "Trend adjusted by risk",
				"formula": "trend_score - (risk_score * 0.3)",
				"step_by_step": [
					"risk_adjustment = risk_score * 0.3",
					"result_raw = trend_score - risk_adjustment",
					"result = clamp(result_raw, 0, 100)"
				],
				"clamp": true,
				"min": 0,
				"max": 100
			}
		}
	},
