{
	"system": {
		"name": "SchemaI_Market_Engine",
		"version": "V7.3",
		"type": "single_source_truth_engine",
		"consistency_level": "strict_deterministic_cross_ai",
		"checksum_method": "sha256"
	},
	"core": {
		"inputs": [
			"price",
			"volume",
			"market_structure"
		],
		"outputs": [
			"trend_score",
			"risk_score",
			"cycle_state",
			"market_phase"
		]
	},
	"engine": {
		"constants": {
			"trend_anchor": 120,
			"risk_anchor": 180,
			"vol_anchor": 180,
			"cycle_length": 4,
			"ganzhi_cycle_length": 60,
			"lunar_mansion_count": 28
		},
		"weights": {
			"trend": {
				"jupiter": 0.4,
				"moon_phase": 0.2,
				"host_star": 0.15,
				"elements": 0.15,
				"solar_term": 0.1,
				"total": 1
			},
			"risk": {
				"saturn": 0.6,
				"mars": 0.4,
				"total": 1
			}
		},
		"determinism_hash": {
			"enabled": true,
			"method": "sha256",
			"input_for_hash": "sorted_json(input) + epoch_date + deterministic_rules",
			"purpose": "cross_ai_verification"
		},
		"execution_lock": {
			"enforce_strict_mapping": true,
			"bindings": {
				"moon_phase": "maps.moon_phase[input.moon_phase]",
				"host_star": "maps.host_star_score[input.host_star]",
				"ganzhi": "maps.ganzhi_score[input.ganzhi]"
			},
			"no_raw_string_usage": true,
			"no_ai_interpretation": true,
			"no_inference": true,
			"force_numeric_cast": true,
			"fail_on_unmapped": true
		},
		"drift_model": {
			"description": "How values change over time",
			"trend_jupiter_step": 0.2,
			"saturn_step": 0.15,
			"mars_step": 0.3,
			"mode": "linear_deterministic",
			"steps": [
				{
					"day": 0,
					"moon_jupiter_change": 0,
					"moon_saturn_change": 0,
					"mars_angle_change": 0
				},
				{
					"day": 1,
					"moon_jupiter_change": 0.25,
					"moon_saturn_change": 0.18,
					"mars_angle_change": 0.35
				}
			]
		},
		"epoch": {
			"base_date": "2026-05-30",
			"base_date_format": "YYYY-MM-DD",
			"unit": "days",
			"reference_system": "gregorian_calendar",
			"timezone": "UTC"
		},
		"scan_rule": {
			"condition": "cycle.state == 'D1' AND trend_score >= 85 AND risk_score >= 80 AND volatility_mars >= 85",
			"description": "D1 trigger condition",
			"thresholds": {
				"trend_score_min": 85,
				"risk_score_min": 80,
				"volatility_mars_min": 85,
				"cycle_state_required": "D1"
			},
			"stop_at_first_hit": true,
			"evaluation_order": [
				"cycle_state_check",
				"trend_score_check",
				"risk_score_check",
				"volatility_mars_check"
			]
		},
		"time_propagation": {
			"enabled": true,
			"mode": "linear_accumulation",
			"rules": {
				"moon_jupiter": {
					"change_per_day": 0.25,
					"unit": "degrees",
					"description": "Jupiter moves 0.25° per day"
				},
				"moon_saturn": {
					"change_per_day": 0.18,
					"unit": "degrees",
					"description": "Saturn moves 0.18° per day"
				},
				"mars_angle": {
					"change_per_day": 0.35,
					"unit": "degrees",
					"description": "Mars moves 0.35° per day"
				}
			},
			"wrap": {
				"moon_jupiter": 360,
				"moon_saturn": 360,
				"mars_angle": 360
			},
			"wrap_operation": "modulo_360",
			"formula": {
				"moon_jupiter_day_n": "(input.moon_jupiter + 0.25 * days_elapsed) % 360",
				"moon_saturn_day_n": "(input.moon_saturn + 0.18 * days_elapsed) % 360",
				"mars_angle_day_n": "(input.mars_angle + 0.35 * days_elapsed) % 360"
			}
		},
		"binding_rules": {
			"moon_phase": {
				"source": "input.moon_phase",
				"lookup": "maps.moon_phase",
				"output_name": "moon_phase_value"
			},
			"host_star": {
				"source": "input.host_star",
				"lookup": "maps.host_star_score",
				"output_name": "host_star_value",
				"fallback": 75
			},
			"ganzhi": {
				"source": "input.ganzhi",
				"lookup": "maps.ganzhi_score",
				"output_name": "ganzhi_value"
			}
		},
		"execution_engine": {
			"mode": "strict_deterministic_runtime",
			"rules": {
				"ALL_VALUES_MUST_BE_RESOLVED": true,
				"NO_STRING_PASS_THROUGH": true,
				"NO_UNMAPPED_VALUES": true,
				"ALL_ENUMS_MUST_BE_VALIDATED": true,
				"ALL_RESULTS_MUST_BE_CLAMPED": true
			},
			"resolution_order": [
				"validate_input",
				"lookup_map_values",
				"numeric_cast",
				"compute_base_formulas",
				"compute_composite_formulas",
				"compute_final_score",
				"evaluate_cycle_state",
				"output_results"
			],
			"enforcement": {
				"fail_on_missing_map": true,
				"fail_on_unknown_enum": true,
				"fail_on_type_mismatch": true,
				"fail_on_range_violation": true
			}
		},
		 "decision_report_engine": {
    "asset_role_engine": {
      "roles": [
        "取勢",
        "取鋒",
        "取材",
        "取穩"
      ],
      "mapping_rules": {
        "leader": "取鋒",
        "core_trend": "取勢",
        "supply_chain": "取材",
        "defensive": "取穩"
      }
    },
    "entry_window_engine": {
      "enabled": true,
      "inputs": [
        "market_phase",
        "trend_score",
        "risk_score"
      ],
      "rules": {
        "accumulation": {
          "entry_offset_days": 0
        },
        "early_expansion": {
          "entry_offset_days": 3
        },
        "late_expansion": {
          "entry_offset_days": 5
        }
      },
      "output": [
        "best_entry_start",
        "best_entry_end"
      ]
    },
    "main_trend_projection": {
      "enabled": true,
      "projection_days": 40,
      "inputs": [
        "daily_simulator",
        "market_phase"
      ],
      "output": [
        "main_trend_start",
        "main_trend_end"
      ]
    },
    "capital_flow_ranking": {
      "enabled": true,
      "ranking_method": "rotation_strength",
      "output": [
        "first_wave",
        "second_wave",
        "third_wave"
      ]
    },
    "narrative_template_engine": {
      "enabled": true,
      "styles": [
        "white_gui",
        "livermore",
        "technical"
      ],
      "white_gui_templates": [
        "鋒先動，勢後成；材隨勢聚，穩待眾歸。",
        "勢起則鋒行，鋒行則材聚。",
        "先觀勢，再取鋒，後守穩。"
      ]
    }
  }	,
		"host_star_policy": {
			"mode": "strict_enum_only",
			"on_unknown": "fallback_75",
			"no_inference": true,
			"allowed_values": 28,
			"fallback_logic": "Use 75 if host_star is not in the 28 lunar mansions list"
		},
		"scan_execution": {
			"mode": "pure_stateless_per_day",
			"no_memory": true,
			"no_carry_forward": true,
			"fresh_evaluation": "each day from base_date"
		},
		"moon_phase_score_source": "maps.moon_phase",
		"maps": {
			"moon_phase": {
				"new_moon": 65,
				"first_quarter": 75,
				"full_moon": 85,
				"last_quarter": 70
			},
			"host_star_score": {
				"角木蛟": 80,
				"亢金龍": 82,
				"氐土貉": 78,
				"房日兔": 76,
				"心月狐": 81,
				"尾火虎": 83,
