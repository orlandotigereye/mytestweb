				"危月燕": 81,
				"室火豬": 82,
				"壁水貐": 80,
				"奎木狼": 81,
				"婁金狗": 78,
				"胃土雉": 75,
				"昴日雞": 85,
				"畢月烏": 80,
				"觜火猴": 82,
				"參水猿": 79,
				"井木犴": 78,
				"鬼金羊": 77,
				"柳土獐": 76,
				"星日馬": 80,
				"張月鹿": 81,
				"翼火蛇": 83,
				"軫水蚓": 79
			},
			"ganzhi_score": {
				"甲子": 50,
				"乙丑": 51,
				"丙寅": 52,
				"丁卯": 53,
				"戊辰": 54,
				"己巳": 55,
				"庚午": 56,
				"辛未": 57,
				"壬申": 58,
				"癸酉": 59,
				"甲戌": 60,
				"乙亥": 59,
				"丙子": 58,
				"丁丑": 57,
				"戊寅": 56,
				"己卯": 55,
				"庚辰": 54,
				"辛巳": 53,
				"壬午": 52,
				"癸未": 51,
				"甲申": 50,
				"乙酉": 51,
				"丙戌": 52,
				"丁亥": 53,
				"戊子": 54,
				"己丑": 55,
				"庚寅": 56,
				"辛卯": 57,
				"壬辰": 58,
				"癸巳": 59,
				"甲午": 60,
				"乙未": 59,
				"丙申": 58,
				"丁酉": 57,
				"戊戌": 56,
				"己亥": 55,
				"庚子": 54,
				"辛丑": 53,
				"壬寅": 52,
				"癸卯": 51,
				"甲辰": 50,
				"乙巳": 51,
				"丙午": 52,
				"丁未": 53,
				"戊申": 54,
				"己酉": 55,
				"庚戌": 56,
				"辛亥": 57,
				"壬子": 58,
				"癸丑": 59,
				"甲寅": 60,
				"乙卯": 59,
				"丙辰": 58,
				"丁巳": 57,
				"戊午": 56,
				"己未": 55,
				"庚申": 54,
				"辛酉": 53,
				"壬戌": 52,
				"癸亥": 51
			}
		},
		"formulas": {
			"trend_jupiter": "100 - abs(moon_jupiter - 120) / 120 * 100",
			"risk_saturn": "100 - abs(moon_saturn - 180) / 180 * 100",
			"volatility_mars": "100 - abs(mars_angle - 180) / 180 * 100",
			"element_score": "100 - (max(wood,fire,earth,metal,water) - min(wood,fire,earth,metal,water)) * 2",
			"solar_term_score": "max(0, 100 - (solar_term_days / 15 * 100))"
		},
		"scoring": {
			"trend_score": {
				"formula": "0.40*trend_jupiter + 0.20*moon_phase + 0.15*host_star + 0.15*element_score + 0.10*solar_term_score",
				"weights": {
					"trend_jupiter": 0.4,
					"moon_phase": 0.2,
					"host_star": 0.15,
					"element_score": 0.15,
					"solar_term_score": 0.1
				},
				"min": 0,
				"max": 100
			},
			"risk_score": {
				"formula": "0.60*risk_saturn + 0.40*volatility_mars",
				"weights": {
					"risk_saturn": 0.6,
					"volatility_mars": 0.4
				},
				"min": 0,
				"max": 100
			},
			"final_score": {
				"formula": "trend_score - (risk_score * 0.3)",
				"description": "Trend reduced by risk component",
				"min": 0,
				"max": 100
			}
		},
		"cycle": {
			"length": 4,
			"states": [
				"IDLE",
				"D1",
				"D2",
				"D3",
				"D4"
			],
			"state_descriptions": {
				"IDLE": "No signal",
				"D1": "Primary signal (highest priority)",
				"D2": "Secondary signal",
				"D3": "Tertiary signal",
				"D4": "Quaternary signal"
			},
			"tie_breaker": {
				"method": "earliest_date_wins",
				"score_priority": "final_score",
				"deterministic_sort": true,
				"secondary_sort": "ganzhi_index_asc"
			},
			"state_snapshot": {
				"enabled": true,
				"store_each_day": true,
				"fields_captured": [
					"date",
					"trend_score",
					"risk_score",
					"volatility_mars",
					"final_score",
					"cycle_state",
					"moon_jupiter",
					"moon_saturn",
					"mars_angle"
				]
			},
			"priority": {
				"D1": 3,
				"D2": 2,
				"D3": 1,
				"D4": 0,
				"IDLE": -1
			},
			"d1_trigger": {
				"trend_score_gte": 85,
				"risk_score_gte": 80,
				"volatility_mars_gte": 85,
				"all_conditions_must_be_met": true
			},
			"d2_trigger": {
				"trend_score_gte": 75,
				"risk_score_gte": 70,
				"description": "When D1 not met but trend is strong"
			},
			"d3_trigger": {
				"trend_score_gte": 65,
				"description": "When D2 not met but trend is moderate"
			},
			"d4_trigger": {
				"trend_score_gte": 55,
				"description": "When D3 not met but trend is present"
			},
			"lock": true
		},
		"decision_zones": {
			"final_score": {
				"85_100": {
					"label": "main_uptrend",
					"description": "Strong uptrend signal"
				},
				"75_85": {
					"label": "bull",
					"description": "Bullish momentum"
				},
				"65_75": {
					"label": "range",
					"description": "Range-bound trading"
				},
				"55_65": {
					"label": "consolidation",
					"description": "Consolidation pattern"
				},
				"45_55": {
					"label": "bearish",
					"description": "Bearish pressure"
				},
				"0_45": {
					"label": "high_risk",
					"description": "High risk zone"
				}
			}
		}
	},
	"market_model": {
		"behavior_layer": {
			"signals": [
				"breakout",
				"fake_breakout",
				"accumulation",
				"distribution",
				"trend_continuation",
				"exhaustion"
			],
			"inputs": [
				"price_action",
				"volume_profile",
				"range_structure"
			]
		},
		"engine": {
			"probability_engine": {
				"enabled": true,
				"normalization": "softmax",
				"inputs": [
					"trend_score",
					"risk_score",
					"cycle_score",
					"market_phase"
				],
				"scenario_weights": {
					"bull_continuation": {
						"trend_score": 0.5,
						"risk_score": -0.2,
						"cycle_score": 0.3
					},
					"distribution_top": {
						"trend_score": 0.1,
						"risk_score": 0.6,
						"cycle_score": 0.3
					},
					"shakeout_rebound": {
						"trend_score": 0.2,
						"risk_score": 0.4,
						"cycle_score": 0.4
					},
					"trend_reversal": {
						"trend_score": -0.4,
						"risk_score": 0.5,
						"cycle_score": 0.1
					}
				},
				"output": {
					"top_scenario": true,
					"all_probabilities": true
				}
			},
			"day_by_day_simulator": {
				"enabled": true,
				"horizon_days": 40,
				"step_unit": "day",
				"generate": [
					"date",
					"phase",
					"trend_score",
					"risk_score",
					"cycle_state",
					"market_behavior"
				],
				"phase_transition_matrix": {
					"accumulation": [
						"early_expansion"
					],
					"early_expansion": [
						"late_expansion"
					],
					"late_expansion": [
						"distribution",
						"second_rally"
					],
					"distribution": [
						"shakeout"
					],
					"shakeout": [
						"accumulation"
					],
					"second_rally": [
						"exhaustion"
					],
					"exhaustion": [
						"distribution"
					]
				},
				"daily_drift": {
					"trend_score": 2,
					"risk_score": 1
				}
			},
			"feedback_loop": {
				"enabled": true,
				"compare_fields": [
					"trend_score",
					"risk_score",
					"market_phase"
				],
				"adjustment": {
					"mode": "incremental",
					"learning_rate": 0.05,
					"max_adjustment": 0.2
				},
				"triggers": {
					"trend_error": 10,
					"risk_error": 10
				},
				"actions": [
					"update_weights",
					"update_phase_confidence"
				]
			}
		},
		"phase_semantics": {
			"accumulation": "smart money building position",
			"early_expansion": "trend ignition phase",
			"late_expansion": "public participation phase",
			"distribution": "smart money exit phase",
			"shakeout": "weak hands removal",
			"exhaustion": "trend fatigue"
		},
		"backtest_validator": {
			"enabled": true,
			"lookback_days": 365,
			"metrics": [
				"phase_accuracy",
				"trend_accuracy",
				"scenario_accuracy"
			]
		},
		"smart_money_engine": {
			"enabled": true,
			"signals": [
				"accumulation",
				"markup",
				"distribution",
				"markdown",
				"spring",
				"upthrust",
				"absorption",
				"reaccumulation"
			],
			"confidence_mode": "weighted",
			"inputs": [
				"trend_score",
				"risk_score",
				"volume_strength",
				"market_phase"
			],
			"signal_weights": {
				"trend_score": 0.35,
				"volume_strength": 0.35,
				"market_phase": 0.2,
				"risk_score": 0.1
			},
			"outputs": [
				"smart_money_state",
				"confidence_score"
			]
		},
		"confidence_engine": {
			"enabled": true,
			"score_range": [
				0,
				100
			],
			"inputs": [
				"backtest_accuracy",
				"phase_stability",
				"signal_quality",
				"scenario_probability"
			],
			"weights": {
				"backtest_accuracy": 0.35,
				"phase_stability": 0.25,
				"signal_quality": 0.2,
				"scenario_probability": 0.2
			},
			"outputs": [
				"confidence_score",
				"confidence_band"
			]
		},
		"signal_engine": {
			"enabled": true,
			"signal_types": [
				"buy",
				"add_position",
				"hold",
				"reduce",
				"exit"
			],
			"rules": {
				"buy": {
					"trend_score_min": 70,
					"risk_score_max": 40
				},
				"add_position": {
					"trend_score_min": 80,
					"risk_score_max": 50
				},
				"reduce": {
					"risk_score_min": 70
				},
				"exit": {
					"risk_score_min": 85
				}
			},
			"outputs": [
				"signal",
				"signal_strength"
			]
		},
		"risk_management_engine": {
			"enabled": true,
			"max_portfolio_risk": 0.02,
			"position_sizing": {
				"mode": "risk_based"
			},
			"stop_loss": {
				"enabled": true,
				"default_percent": 8
			},
			"take_profit": {
				"enabled": true,
				"default_percent": 20
			},
			"outputs": [
				"recommended_position_size",
				"recommended_stop_loss",
				"recommended_take_profit"
			]
		},
		"adaptive_weights": {
			"by_phase": {
				"accumulation": {
					"volume": 0.5,
					"trend": 0.3,
					"risk": 0.2
				},
				"distribution": {
					"risk": 0.5,
					"volume": 0.3,
					"trend": 0.2
				},
				"trend": {
					"trend": 0.6,
					"volume": 0.3,
					"risk": 0.1
				}
			}
		},
		"rotation_engine": {
			"flow_states": [
				"leader_run",
				"sector_rotation",
				"lagger_catchup",
				"defensive_flow"
			],
			"rules": {
				"leader_run": "trend_score > 80",
				"rotation": "leader_fading AND lagger_strengthening"
			}
		},
		"advanced_simulation": {
			"probability_engine": {
				"enabled": true,
				"version": "V1",
				"normalization": "softmax",
				"inputs": [
					"trend_score",
					"risk_score",
