			},
			{
				"step": 3,
				"name": "compute_base_scores",
				"action": "Calculate trend_jupiter, risk_saturn, volatility_mars, element_score, solar_term_score",
				"formulas": [
					"trend_jupiter",
					"risk_saturn",
					"volatility_mars",
					"element_score",
					"solar_term_score"
				]
			},
			{
				"step": 4,
				"name": "compute_trend_risk",
				"action": "Combine base scores into trend_score and risk_score",
				"formulas": [
					"trend_score",
					"risk_score"
				]
			},
			{
				"step": 5,
				"name": "compute_final",
				"action": "Calculate final_score from trend and risk",
				"formula": "final_score"
			},
			{
				"step": 6,
				"name": "evaluate_cycle",
				"action": "Determine cycle state (IDLE/D1/D2/D3/D4)",
				"logic": "Check thresholds in order: D1 → D2 → D3 → D4 → IDLE"
			},
			{
				"step": 7,
				"name": "output_results",
				"action": "Return scores and state for this day"
			},
			{
				"step": 8,
				"name": "propagate_time",
				"action": "Advance to next day and repeat",
				"repeat_for": "40 days or until D1 found"
			}
		],
